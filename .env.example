# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repo.

# --- Qué datos usa la app
# fake = datos de ejemplo en el navegador (sin backend). supabase = proyecto real.
NEXT_PUBLIC_DATA=fake
# Sin Supabase la app siempre es demo. Con Supabase, 1 = mantener el equipo de ejemplo en el login (no usar en producción real)
NEXT_PUBLIC_DEMO=0
# URL pública de la app, sin barra final (se usa en enlaces de correos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Settings > API Keys). Usa las claves nuevas: las "anon/service_role" dejan de funcionar a fines de 2026.
NEXT_PUBLIC_SUPABASE_URL=
# empieza con sb_publishable_ (va al navegador; RLS la limita)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# empieza con sb_secret_ (SOLO servidor; salta RLS)
SUPABASE_SECRET_KEY=

# --- Correo (Resend). El dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM="Tu App <hola@tudominio.cl>"
